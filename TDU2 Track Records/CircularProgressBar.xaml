<UserControl x:Class="TDU2_Track_Records.CircularProgressBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="CircularProgressBarControl" UseLayoutRounding="True">
    <StackPanel HorizontalAlignment="Center">
        <Grid Width="64" Height="64">
            <Image Source="{Binding Icon, ElementName=CircularProgressBarControl}" Stretch="None"
                   HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <Ellipse Width="62" Height="62"
                     Stroke="{Binding PathColor, ElementName=CircularProgressBarControl}"
                     StrokeThickness="4" Opacity="0.38"/>
            <Path x:Name="progressPath" Data="{Binding ArcData, ElementName=CircularProgressBarControl}"
                  Stroke="{Binding StrokeColor, ElementName=CircularProgressBarControl}"
                  StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Grid>
        <TextBlock Text="{Binding ProgressText, ElementName=CircularProgressBarControl}"
                   Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
    </StackPanel>
</UserControl>
