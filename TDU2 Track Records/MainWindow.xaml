                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="READY" Foreground="#FFFFB4AA" FontSize="10" FontWeight="Bold"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="DPI-aware layout  |  " Foreground="{DynamicResource AppMutedForegroundBrush}" FontSize="10"/>
                        <TextBlock x:Name="HudResolutionText" Foreground="{DynamicResource AppTitleForegroundBrush}" FontSize="10"/>
                    </StackPanel>
                </Grid>
            </Border>

