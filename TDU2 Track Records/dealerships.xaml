<Window x:Class="TDU2_Track_Records.dealerships"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:p="clr-namespace:TDU2_Track_Records.Properties"
        xmlns:local="clr-namespace:TDU2_Track_Records"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d" FontFamily="Adobe Gothic Std B" FontSize="22"
        Title="Dealerships" WindowStyle="None" AllowsTransparency="True" 
        Opacity="{Binding Source={x:Static p:Settings.Default}, Path=MainWindowOpacity, Mode=OneWay}"
        Background="{x:Null}" HorizontalContentAlignment="Stretch"
        ScrollViewer.HorizontalScrollBarVisibility="Auto" MouseLeftButtonDown="dealerships_MouseLeftButtonDown"
        MinWidth="1100" MinHeight="500" ResizeMode="CanResizeWithGrip"
        SizeToContent="WidthAndHeight">
    <Border BorderBrush="{DynamicResource AppShellBorderBrush}" BorderThickness="{DynamicResource AppShellBorderThickness}"
            CornerRadius="{DynamicResource AppShellCornerRadius}"
            Margin="0"
            >
        <Border.Background>
            <ImageBrush ImageSource="/Images/backgrounds/carbon.png"
                    TileMode="Tile" 
                    Viewport="0,0,32,32" 
                    ViewportUnits="Absolute" 
                    Stretch="None"/>
        </Border.Background>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" MinWidth="20" MaxWidth="20"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="20" MinWidth="20" MaxWidth="20"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>

            <!-- Stitch-inspired title, island, and search toolbar. -->
            <Grid x:Name="ThumbAndIsland" Grid.Row="1" Grid.Column="1" Margin="0,0,10,6"
                  Background="#F21A1C20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="14,8" VerticalAlignment="Center">
                    <Border Width="5" Background="#FFE52521" Margin="0,0,10,0"/>
                    <TextBlock Text="DEALERSHIPS &amp; SHOWROOMS" Foreground="#FFF2F2F4"
                               FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border Margin="12,0,0,0" Padding="8,3" Background="#FF0C0E12"
                            BorderBrush="#FF3B3E45" BorderThickness="1">
                        <TextBlock x:Name="LocationCountText" Text="LOCATIONS" Foreground="#FFFFB4AA"
                                   FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8" VerticalAlignment="Center">
                    <Menu x:Name="LocationMenus" IsMainMenu="False" Background="Transparent"
                          FontSize="13" VerticalAlignment="Center"
                          PreviewMouseRightButtonDown="LocationMenus_PreviewMouseRightButtonDown"/>
                    <TextBox x:Name="LocationSearchBox" Width="150" Height="34" Padding="10,4" Margin="6,0,0,0"
                             FontSize="14" VerticalContentAlignment="Center"
                             ToolTip="Filter the showrooms listed in the menus"
                             AutomationProperties.Name="Filter showrooms"/>
                </StackPanel>
            </Grid>


            <DockPanel Grid.Column="2" Grid.Row="1" HorizontalAlignment="Right">
                <Image x:Name="Settings_Button" MouseLeftButtonDown="Settings_MouseLeftButtonDown"
                   Margin="0,0,5,0" MinWidth="32" MinHeight="32"
                   ToolTip="Settings" Width="50" Height="50">
                    <Image.Style>
                        <Style TargetType="{x:Type Image}">
                            <Setter Property="Source" Value="Images/ico/navigation/settings.png"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Source" Value="Images/ico/navigation/settings_over.png"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <Image x:Name="Minimize_Button" MouseLeftButtonDown="Minimize_MouseLeftButtonDown"
                   Margin="0,0,5,0"
                   Width="50" Height="50" MinWidth="32" MinHeight="32"
                   ToolTip="Minimize Application">
                    <Image.Style>
                        <Style TargetType="{x:Type Image}">
                            <Setter Property="Source" Value="Images/ico/navigation/minimize.png"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Source" Value="Images/ico/navigation/minimize_over.png"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <Image x:Name="Close_Button" MouseLeftButtonDown="Close_Button_MouseLeftButtonDown"
                   Margin="0,0,5,0"
                   Width="50" Height="50" MinWidth="32" MinHeight="32"
                   ToolTip="Close Application">
                    <Image.Style>
                        <Style TargetType="{x:Type Image}">
                            <Setter Property="Source" Value="Images/ico/navigation/close.png"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Source" Value="Images/ico/navigation/close_over.png"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
            </DockPanel>

            <!-- Compact selected-dealership summary. -->
            <Border x:Name="Dealership" Visibility="Collapsed" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                    Background="#FF1A1C20" BorderBrush="#FF3B3E45" BorderThickness="1" Margin="0,0,0,6">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image x:Name="DealershipImage" Width="225" Height="126" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Margin="14,8" VerticalAlignment="Center">
                        <TextBlock x:Name="DealershipTitleText" Foreground="#FFF2F2F4" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DealershipSubtitleText" Foreground="#FFAAAEB7" FontSize="14" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12">
                        <Border Padding="12,8" Background="#FF0C0E12" BorderBrush="#FF3B3E45" BorderThickness="1" Margin="3">
                            <StackPanel><TextBlock Text="ISLAND" Foreground="#FFAAAEB7" FontSize="11"/>
                                <TextBlock x:Name="DealershipIslandText" Foreground="#FFF2F2F4" FontSize="16" FontWeight="Bold"/></StackPanel>
                        </Border>
                        <Border Padding="12,8" Background="#FF0C0E12" BorderBrush="#FF3B3E45" BorderThickness="1" Margin="3">
                            <StackPanel><TextBlock Text="IN STOCK" Foreground="#FFAAAEB7" FontSize="11"/>
                                <TextBlock x:Name="DealershipStockText" Foreground="#FFFFB4AA" FontSize="16" FontWeight="Bold"/></StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Vehicles Display -->
            <ScrollViewer Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="2" x:Name="VehiclesScrollViewer" FocusVisualStyle="{x:Null}"
                      Margin="0,4,0,0" Visibility="Collapsed"
                      MouseLeftButtonDown="dealerships_MouseLeftButtonDown" VirtualizingStackPanel.IsVirtualizing="True"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="VehiclesStackPanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
